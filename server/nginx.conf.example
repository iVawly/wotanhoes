# Exemplo de configuração Nginx para o site do Wotan's House.
# Site 100% estático: não há backend, banco de dados nem upload.
# Ajuste server_name e os caminhos dos certificados antes de usar.

server {
    listen 80;
    server_name wotanshouse.com.br www.wotanshouse.com.br;
    # Todo tráfego vai para HTTPS.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name wotanshouse.com.br www.wotanshouse.com.br;

    root /var/www/wotans-house;
    index index.html;

    ssl_certificate     /etc/letsencrypt/live/wotanshouse.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wotanshouse.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Não revela a versão do servidor nas respostas nem nas páginas de erro.
    server_tokens off;

    # Sem listagem de diretórios.
    autoindex off;

    # ---- Cabeçalhos de segurança ----
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'; upgrade-insecure-requests" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    # HSTS só depois de confirmar que todo o site funciona em HTTPS.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # ---- Arquivos que nunca devem ser servidos ----
    # .env, .git, backups, dumps, logs e configurações internas.
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location ~* \.(env|log|sql|sqlite|bak|old|swp|dump|pem|key|crt|p12|pfx|ini|yaml|yml|toml)$ {
        deny all;
    }

    location ^~ /server/ {
        deny all;
    }

    # ---- Cache ----
    location /assets/fonts/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location /assets/images/ {
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "public, max-age=0, must-revalidate";
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Páginas de erro simples, sem detalhes internos.
    error_page 404 /index.html;

    # Compressão
    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/manifest+json text/plain;
    gzip_min_length 512;
}
